    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized system administrator UID record",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "serverCreatedAt", "serverUpdatedAt"]
    },
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Non-PII public profile for authenticated operator",
